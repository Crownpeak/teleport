# Dockerfile for building and running Teleport OSS locally
# This builds Teleport from source in a multi-stage build

##############################################################################
# Stage 1: Build Teleport from source
##############################################################################
FROM golang:1.23-bullseye AS builder

# Set GOTOOLCHAIN to auto to allow Go to download required version
ENV GOTOOLCHAIN=auto

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    libpam0g-dev \
    libfido2-dev \
    pkg-config \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Install Rust (required for building)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Node.js (required for web UI)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /teleport

# Copy source code
COPY . .

# Build Teleport (OSS version)
# Using 'make full' to build production binaries with auto toolchain
RUN GOTOOLCHAIN=auto make full

##############################################################################
# Stage 2: Runtime image
##############################################################################
FROM debian:bullseye-slim

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y \
    ca-certificates \
    dumb-init \
    libfido2-1 \
    && rm -rf /var/lib/apt/lists/*

# Copy built binaries from builder stage
COPY --from=builder /teleport/build/teleport /usr/local/bin/teleport
COPY --from=builder /teleport/build/tctl /usr/local/bin/tctl
COPY --from=builder /teleport/build/tsh /usr/local/bin/tsh

# Create teleport user and directories
RUN groupadd -r teleport && \
    useradd -r -g teleport -d /var/lib/teleport -s /bin/bash teleport && \
    mkdir -p /var/lib/teleport /etc/teleport && \
    chown -R teleport:teleport /var/lib/teleport /etc/teleport

# Expose ports
# 3023 - SSH proxy
# 3024 - SSH reverse tunnel
# 3025 - Auth service
# 3080 - Web UI and API
EXPOSE 3023 3024 3025 3080

# Set working directory
WORKDIR /var/lib/teleport

# Use dumb-init to handle signals properly
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Default command
CMD ["/usr/local/bin/teleport", "start"]
